# ============================================================================
# INDUSTRAC S.A.C. — VARIABLES DE ENTORNO
# Copia este archivo como .env y completa los valores correspondientes.
# ============================================================================

# Conexión a Supabase (Backend únicamente)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=tu_supabase_service_role_secret_key

# Webhook de Google Apps Script para almacenamiento oficial de PDFs en Google Drive
GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycby-tu-webhook/exec

# Clave secreta para autorizar operaciones de escritura (POST, PUT, DELETE)
# Si se deja vacía en desarrollo local, permite el acceso desde el navegador local.
API_SECRET_KEY=

# Puerto del servidor local
PORT=3000

